{
  "listName": "LDC_Feedback",
  "description": "User feedback and feature requests for LDC Tools",
  "template": "GenericList",
  "enableVersioning": true,
  "enableContentTypes": false,
  "fields": [
    {
      "internalName": "Title",
      "displayName": "Feedback Title",
      "type": "Text",
      "required": true,
      "indexed": true,
      "maxLength": 255,
      "description": "Brief summary of the feedback"
    },
    {
      "internalName": "FeedbackNumber",
      "displayName": "Feedback Number",
      "type": "Text",
      "required": false,
      "indexed": true,
      "maxLength": 20,
      "description": "Unique feedback identifier (e.g., FB-001)"
    },
    {
      "internalName": "FeedbackType",
      "displayName": "Type",
      "type": "Choice",
      "required": true,
      "choices": [
        "Bug Report",
        "Feature Request",
        "Improvement",
        "Question",
        "Other"
      ],
      "defaultValue": "Feature Request",
      "indexed": true,
      "description": "Type of feedback"
    },
    {
      "internalName": "Status",
      "displayName": "Status",
      "type": "Choice",
      "required": true,
      "choices": [
        "NEW",
        "TRIAGED",
        "IN_PROGRESS",
        "RESOLVED",
        "WONT_FIX",
        "DUPLICATE"
      ],
      "defaultValue": "NEW",
      "indexed": true,
      "description": "Current status of the feedback item"
    },
    {
      "internalName": "Priority",
      "displayName": "Priority",
      "type": "Choice",
      "required": true,
      "choices": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "URGENT"
      ],
      "defaultValue": "MEDIUM",
      "indexed": true,
      "description": "Priority level"
    },
    {
      "internalName": "Requestor",
      "displayName": "Requestor",
      "type": "User",
      "required": true,
      "allowMultiple": false,
      "description": "Person who submitted the feedback"
    },
    {
      "internalName": "RequestorName",
      "displayName": "Requestor Name",
      "type": "Text",
      "required": false,
      "maxLength": 255,
      "description": "Name of requestor (for display purposes)"
    },
    {
      "internalName": "Description",
      "displayName": "Description",
      "type": "Note",
      "required": true,
      "richText": true,
      "appendChanges": false,
      "description": "Detailed description of the feedback"
    },
    {
      "internalName": "ResolutionComment",
      "displayName": "Resolution Comment",
      "type": "Note",
      "required": false,
      "richText": true,
      "appendChanges": false,
      "description": "Comment explaining the resolution"
    },
    {
      "internalName": "AssignedTo",
      "displayName": "Assigned To",
      "type": "User",
      "required": false,
      "allowMultiple": false,
      "description": "Person assigned to address the feedback"
    },
    {
      "internalName": "TargetVersion",
      "displayName": "Target Version",
      "type": "Text",
      "required": false,
      "maxLength": 50,
      "description": "Version where this will be addressed"
    },
    {
      "internalName": "ResolvedDate",
      "displayName": "Resolved Date",
      "type": "DateTime",
      "required": false,
      "format": "DateTime",
      "description": "Date and time feedback was resolved"
    },
    {
      "internalName": "RelatedProject",
      "displayName": "Related Project",
      "type": "Lookup",
      "required": false,
      "lookupList": "LDC_Projects",
      "lookupField": "Title",
      "description": "Related project (if applicable)"
    },
    {
      "internalName": "Votes",
      "displayName": "Votes",
      "type": "Number",
      "required": false,
      "min": 0,
      "decimals": 0,
      "defaultValue": 0,
      "description": "Number of users who voted for this feedback"
    }
  ],
  "views": [
    {
      "name": "All Feedback",
      "default": true,
      "fields": ["FeedbackNumber", "Title", "FeedbackType", "Status", "Priority", "Requestor", "Created"],
      "query": "<OrderBy><FieldRef Name='Created' Ascending='FALSE'/></OrderBy>"
    },
    {
      "name": "New Feedback",
      "fields": ["FeedbackNumber", "Title", "FeedbackType", "Priority", "Requestor", "Created"],
      "query": "<Where><Eq><FieldRef Name='Status'/><Value Type='Choice'>NEW</Value></Eq></Where><OrderBy><FieldRef Name='Priority' Ascending='FALSE'/><FieldRef Name='Created' Ascending='FALSE'/></OrderBy>"
    },
    {
      "name": "In Progress",
      "fields": ["FeedbackNumber", "Title", "AssignedTo", "Priority", "TargetVersion"],
      "query": "<Where><Eq><FieldRef Name='Status'/><Value Type='Choice'>IN_PROGRESS</Value></Eq></Where><OrderBy><FieldRef Name='Priority' Ascending='FALSE'/></OrderBy>"
    },
    {
      "name": "My Feedback",
      "fields": ["FeedbackNumber", "Title", "Status", "Priority", "Created"],
      "query": "<Where><Eq><FieldRef Name='Requestor'/><Value Type='Integer'><UserID/></Value></Eq></Where><OrderBy><FieldRef Name='Created' Ascending='FALSE'/></OrderBy>"
    }
  ],
  "permissions": {
    "breakInheritance": false,
    "notes": "Inherits permissions from parent SharePoint site. All users can submit feedback."
  }
}
